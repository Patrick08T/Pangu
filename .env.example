# 本文件只展示配置项，程序不会自动加载此文件；不要提交真实凭据。
# 本地 Hatchet 可通过 . ./scripts/hatchet-env.ps1 设置这些值。
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_TENANT_ID=
HATCHET_CLIENT_SERVER_URL=http://localhost:28243
HATCHET_CLIENT_HOST_PORT=127.0.0.1:17070
HATCHET_CLIENT_TLS_STRATEGY=none

# 兼容 OpenAI Chat Completions 的模型服务。
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 产品经理公开搜索复用下方 PANGU_CODEX_BINARY / PANGU_CODEX_HOME 的原生 Codex 登录，无需独立搜索密钥。
# 共享模型连接只存此类变量名；具体值通过服务端安全配置加载。
PANGU_SECRET_DEFAULT_MODEL=
# 可选 GitHub Issue 入口签名密钥；值至少32字节，只在服务端配置。
# 在控制台明确启用入口并登记此引用，不会自动创建 GitHub Webhook。
PANGU_HOOK_SECRET_DEFAULT=

# 原生 Codex：使用 scripts/codex-build.ps1 生成的受控原生程序。
# Windows 必须指向 codex.exe，不要指向 npm 的 codex.cmd/codex.ps1。
PANGU_CODEX_BINARY=
# 专用 Worker Codex 目录；独立登录，config.toml 仅登记管理员批准的技能/MCP。
# 不得指向个人 ~/.codex、当前 CODEX_HOME 或 Agent 工作区。
PANGU_CODEX_HOME=
# Worker 的稳定身份，留空使用主机名；登记项目时必须匹配。
PANGU_WORKER_ID=
# 私有工作区根目录，必须是源项目之外的本地绝对路径。
PANGU_WORKSPACE_ROOT=
# 审计数据库故障时的持久补录目录，start.ps1 默认使用 .artifacts/audit。
PANGU_AUDIT_SPOOL_ROOT=
# 同一部署的 API 和 Worker 命名空间必须一致；内部可登记多个项目。
HATCHET_CLIENT_NAMESPACE=pangu

# 独立产品数据库；禁止使用 Hatchet 库和超级用户账号。
# 本地初始化后，通过 . ./scripts/database-env.ps1 加载当前 PostgreSQL 端口。
PANGU_DATABASE_URL=
# 飞书网页登录；PUBLIC_URL 为浏览器访问的同源地址，远程必须 HTTPS。
PANGU_PUBLIC_URL=http://127.0.0.1:8081
PANGU_FEISHU_APP_ID=
PANGU_FEISHU_APP_SECRET=
PANGU_FEISHU_TENANT_KEY=
# 首位管理员必须显式指定，使用当前飞书应用下的 open_id；不会自动授予首登用户。
PANGU_FEISHU_ADMIN_OPEN_ID=
# PANGU_DATABASE_ADMIN_URL 仅在 scripts/database-init.ps1 建库时临时提供，不传给 API/Worker。
