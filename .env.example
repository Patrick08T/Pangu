# 本文件只展示配置项，程序不会自动加载此文件；不要提交真实凭据。
# 本地 Hatchet 可通过 . ./scripts/hatchet-env.ps1 设置这些值。
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_TENANT_ID=
HATCHET_CLIENT_SERVER_URL=http://localhost:28243
HATCHET_CLIENT_HOST_PORT=127.0.0.1:17070
HATCHET_CLIENT_TLS_STRATEGY=none

# 兼容 OpenAI Chat Completions 的模型服务。
OPENAI_API_KEY=
OPENAI_BASE_URL=
